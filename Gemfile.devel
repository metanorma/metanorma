# Local development pins (eval'd by Gemfile; not committed workflow state)
gem "metanorma-document", github: "metanorma/metanorma-document", branch: "main"
gem "metanorma-standoc", github: "metanorma/metanorma-standoc", branch: "main"
gem "metanorma-iso", github: "metanorma/metanorma-iso", branch: "main"
gem "isodoc", github: "metanorma/isodoc", branch: "main"
# released metanorma-iho 1.4.0 still carries lib/relaton/render/general.rb,
# which shadows relaton-render's iso690 autoload by load-path name; iho
# main relocated its render files
gem "metanorma-iho", github: "metanorma/metanorma-iho", branch: "main"
gem "pubid", "~> 2.0.0.pre.alpha"
# The 1.9.356/0.5.13x pin pair worked around the leptris#1733 to_xml
# regression; retired — moxml rides the 0.6 line (0.5 series gets no
# fixes; 0.6.0 removed the Opal surface, lutaml/moxml#516), which
# floors leptris >= 1.9.386 at load.
gem "leptris", "~> 1.9"
gem "relaton-cli", "~> 3.0.0.pre.alpha"
gem "glossarist", "~> 2.13"
gem "lutaml-model", "~> 0.8.107"
gem "metanorma-plugin-glossarist", "~> 0.5"
gem "moxml", "~> 0.6.0"

gem "parsanol", "~> 1.3.129" # relaton 3.1 floor; pubid edition-2 grammar era

# Bridge: svg_conform 0.2.5 was pushed with a compact-index checksum
# mismatch (Bundler::APIResponseMismatchError on every download); pin
# 0.2.4 until a corrected push lands.
gem "svg_conform", "0.2.4"
